# Run: python3 scripts/bootstrap_env.py (generates private random secrets in .env).
# Local demo only. Real FR/DE/GB channels remain disabled in seed_demo.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
API_TOKEN=
ENABLE_DEMO_PROVIDER=true
DEMO_PROVIDER_TOKEN=
CRAWLER_ALLOWED_HOSTS=127.0.0.1,localhost,web
COOKIE_SECURE=false

# Used by Docker Compose; leave DB_HOST unset for local SQLite.
DB_NAME=visa_appointment
DB_USER=visa_appointment
DB_PASSWORD=
