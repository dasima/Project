{
	# In HA, set only the real LB source CIDRs. Network policy must prevent
	# clients from reaching this HTTP edge directly and forging forwarded TLS.
	servers {
		trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

{$SITE_ADDRESSES:http://localhost} {
	encode zstd gzip

	@django path /api/* /admin /admin/* /healthz /healthz/ /readyz /readyz/
	handle @django {
		# Caddy sets forwarded headers and only preserves an incoming
		# X-Forwarded-Proto from the trusted proxies configured above.
		reverse_proxy web:8000
	}

	handle_path /static/* {
		root * /srv/django-static
		file_server
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
