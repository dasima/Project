# Required secrets: generate independently, keep private, never commit .env.
# For HA prefer --env-file /secure/path/parcelink.env outside this repository.
# For example: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=
DB_PASSWORD=

# Single-machine LOCAL trial only. Production: false + registered HTTPS hosts.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
SITE_ADDRESSES=http://localhost
# Public HTTPS: quote registered hosts separated by comma + SPACE.
# SITE_ADDRESSES="your-primary-host, your-backup-host" (replace both placeholders).
# Put every main/backup hostname in ALLOWED_HOSTS and every HTTPS origin in CSRF.
# Do not set http:// for an Internet-facing production site.

DB_NAME=logistics
DB_USER=logistics
# Local compose always uses its private db service. HA requires an external host.
DB_HOST=
DB_PORT=5432
# Local PostgreSQL: prefer. Managed PostgreSQL HA: require (or verify-full + CA).
DB_SSLMODE=prefer

# Standalone HA: use deploy/compose.ha.yaml and set these to real LB CIDRs.
# Each VM must use the same SECRET_KEY and external database credentials.
# Override DB_SSLMODE=prefer above to require for the managed database.
# The LB terminates HTTPS, overwrites X-Forwarded-Proto, and checks /readyz/.
# Firewall TCP 8080 to the LB only; never expose Gunicorn port 8000.
TRUSTED_PROXY_CIDRS=
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=8080

# Placeholder company information, visibly marked as such in the UI.
COMPANY_NAME=项目名称待定
PHONE=000-00000000
EMAIL=support@example.com
# Public frontend links only. Leave blank until real domains are configured.
PRIMARY_DOMAIN=
BACKUP_DOMAINS=
