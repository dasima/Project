# Copy to an untracked .env and export its values before running manage.py.
# Generate a new secret once and share the same value across all app instances.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HEADERS=false

DB_NAME=logistics
DB_USER=logistics
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Managed PostgreSQL can require DB_SSLMODE=verify-full and PGSSLROOTCERT.
DB_SSLMODE=
PGOPTIONS=

# These are visibly labelled placeholders until replaced with real details.
COMPANY_NAME=项目名称待定
PHONE=000-00000000
EMAIL=support@example.com
PRIMARY_DOMAIN=
BACKUP_DOMAINS=
